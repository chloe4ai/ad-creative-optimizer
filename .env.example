# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890

# Meta Marketing API
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_ACCESS_TOKEN=your_access_token
META_AD_ACCOUNT_ID=act_123456789

# TikTok Marketing API
TIKTOK_APP_ID=your_app_id
TIKTOK_APP_SECRET=your_app_secret
TIKTOK_ACCESS_TOKEN=your_access_token
TIKTOK_AD_ACCOUNT_ID=your_ad_account_id

# Pinterest API
PINTEREST_APP_ID=your_app_id
PINTEREST_APP_SECRET=your_app_secret
PINTEREST_ACCESS_TOKEN=your_access_token

# LinkedIn API
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_ACCESS_TOKEN=your_access_token

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ad_optimizer
# Security (required — the server refuses to start without it)
# Shared secret every /api request must send in the `x-api-key` header. `openssl rand -hex 32`
API_KEY=change-me-openssl-rand-hex-32
# Browser origin(s) allowed by CORS, comma-separated. Unset = no browser may call the API.
FRONTEND_ORIGIN=http://localhost:3001

# Slack Notification
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_TO=alerts_recipient@example.com

# Server
PORT=3000
NODE_ENV=development
