{
  "name": "ad-creative-optimizer",
  "version": "0.1.0",
  "description": "AI-powered ad creative fatigue prediction and optimization tool",
  "type": "module",
  "main": "src/api/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/api/index.js",
    "start": "node src/api/index.js",
    "test": "node --test test/prediction.test.js test/sync.test.js test/auth.test.js test/tokenCrypto.test.js test/config.test.js",
    "encrypt-tokens": "node scripts/encrypt-existing-tokens.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "facebook-nodejs-business-sdk": "^19.0.0",
    "google-ads-api": "^19.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
